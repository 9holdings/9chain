# === 9CHAIN-A1 OVERRIDES ===
# Append vào docker-compose/envs/common-blockscout.env của Blockscout (setup.sh tự làm).
# Dòng marker phía trên là mốc để setup.sh cắt bỏ block cũ — ĐỪNG sửa.

# Trỏ indexer vào C-Chain 9Chain-A1 (từ container: host.docker.internal -> node trên host)
ETHEREUM_JSONRPC_HTTP_URL=http://host.docker.internal:9650/ext/bc/C/rpc
ETHEREUM_JSONRPC_TRACE_URL=http://host.docker.internal:9650/ext/bc/C/rpc
ETHEREUM_JSONRPC_WS_URL=ws://host.docker.internal:9650/ext/bc/C/ws
ETHEREUM_JSONRPC_VARIANT=geth

# C-Chain không bật debug trace mặc định -> tắt internal/pending tx fetcher
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
DISABLE_EXCHANGE_RATES=true

# Postgres không SSL (tránh 'ssl not available') + pool vừa phải
ECTO_SSL_MODE=disable
DATABASE_SSL_ENABLED=false
ECTO_USE_SSL=false
POOL_SIZE=20

# Branding backend
COIN=LOVE9
COIN_NAME=LOVE9
NETWORK=9Chain-A1
SUBNETWORK=C-Chain
