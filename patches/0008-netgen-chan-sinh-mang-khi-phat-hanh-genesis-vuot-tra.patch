 	fmt.Fprintf(&b, "Tổng phát hành genesis: **%s LOVE9** · Trần cung: **%s LOVE9**\n\n",
-		love9(totalGenesisSupply()), love9(supplyCapLOVE9*unitLOVE9))
+		love9(totalGenesisSupply()), love9(supplyCap()))
