 	twoYears    = 2 * oneYear
 	fourYears   = 4 * oneYear
@@ -131,6 +125,42 @@ func totalGenesisSupply() uint64 {
 	return t
 }
 
+// supplyCap đọc THẲNG từ `genesis.A1Params` — chính hằng số mà node biên dịch vào
+// binary. Trước đây báo cáo in một bản chép tay và nó đã trôi lệch (còn ghi 720
+// triệu sau khi trần lên 9 tỷ). netgen nằm trong cùng module với avalanchego nên
+// không có lý do gì để chép.
+func supplyCap() uint64 { return genesis.A1Params.RewardConfig.SupplyCap }
+
+// mustFitSupplyCap chặn lượt sinh mạng khi phát hành genesis vượt trần cung.
+//
+// 🔴 VÌ SAO PHẢI CHẶT: `reward/calculator.go:56` tính
+// `remainingSupply := c.supplyCap - currentSupply` bằng phép trừ `uint64` THÔ,
+// không kiểm dấu. Phát hành genesis > trần ⇒ TRÀN NGƯỢC thành một số gần 2^64.
+// Đo với trần cũ 720 triệu và phát hành 5,4 tỷ: remainingSupply hoá
+// 13,766,744,073 LOVE9 — lớn hơn cả trần định đặt — và bước
+// `SetCurrentSupply(currentSupply + potentialReward)` khi đó vượt luôn `uint64`.
+//
+// Không có tầng nào khác bắt việc này: avalanchego KHÔNG kiểm `initialSupply ≤
+// supplyCap` ở bất kỳ đâu, node vẫn khởi động sạch, mọi phép đo vẫn xanh — sai lệch
+// chỉ hiện ra ở phần thưởng staking, tức nhiều ngày sau khi mạng đã công khai.
+//
+// ⚠️ Cổng này chỉ đối chiếu bảng phân bổ với binary ĐANG BIÊN DỊCH RA NETGEN.
+// Nó KHÔNG biết node trên server chạy image nào. Deploy genesis mới lên image cũ
+// vẫn lọt — đó là việc của quy trình deploy, xem `docs/PROGRESS.md`.
+func mustFitSupplyCap() {
+	total, cap_ := totalGenesisSupply(), supplyCap()
+	if total <= cap_ {
+		return
+	}
+	fmt.Fprintf(os.Stderr,
+		"FATAL phát hành genesis %s LOVE9 VƯỢT trần cung %s LOVE9.\n"+
+			"       Trần lấy từ genesis.A1Params (biên dịch vào binary này).\n"+
+			"       Sinh mạng như vậy làm remainingSupply tràn ngược uint64 ở\n"+
+			"       reward/calculator.go — mạng chạy bình thường nhưng phát thưởng sai.\n",
+		love9(total), love9(cap_))
+	os.Exit(1)
+}
