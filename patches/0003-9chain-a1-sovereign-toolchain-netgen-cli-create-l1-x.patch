+// 9chain-a1-cli — CLI factory L1 cho nền tảng 9Chain-A1 (rebrand, chuyên dụng cho
+// mạng chủ quyền của 9Chain-A1, KHÔNG spin up mạng riêng như avalanche-cli).
+//
+// Lệnh:
+//   9chain-a1-cli version
+//   9chain-a1-cli info      --uri http://localhost:9650
+//   9chain-a1-cli l1 create --uri ... --genesis /path.json --name MyChain
+//   9chain-a1-cli l1 list   --uri ...
+//
+// Không thêm dependency mới (dùng flag + net/http + wallet SDK có sẵn).
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"flag"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strconv"
+	"time"
+
+	"github.com/ava-labs/avalanchego/genesis"
+	"github.com/ava-labs/avalanchego/ids"
+	"github.com/ava-labs/avalanchego/utils/cb58"
+	"github.com/ava-labs/avalanchego/utils/crypto/secp256k1"
+	"github.com/ava-labs/avalanchego/vms/platformvm/txs"
+	"github.com/ava-labs/avalanchego/vms/secp256k1fx"
+	pwallet "github.com/ava-labs/avalanchego/wallet/chain/p/wallet"
+	"github.com/ava-labs/avalanchego/wallet/subnet/primary"
+)
+
+const banner = "9Chain Testnet A1 CLI (Avalanche) — nền tảng multi-L1"
+
+// MinStakeDuration của mạng A1 (24h). Đăng ký ngắn hơn là tx bị từ chối.
+const minSubnetStakeSeconds = 24 * 60 * 60
+
+// parsePrivateKey đọc khoá dạng "PrivateKey-<cb58>" (định dạng chuẩn của
+// avalanchego, cũng là định dạng netgen ghi ra keys.txt) hoặc cb58 trần.
+func parsePrivateKey(s string) (*secp256k1.PrivateKey, error) {
+	raw := s
+	if len(s) > len(secp256k1.PrivateKeyPrefix) && s[:len(secp256k1.PrivateKeyPrefix)] == secp256k1.PrivateKeyPrefix {
+		raw = s[len(secp256k1.PrivateKeyPrefix):]
+	}
+	b, err := cb58.Decode(raw)
+	if err != nil {
+		return nil, fmt.Errorf("khoa khong phai dang PrivateKey-<cb58>: %w", err)
+	}
+	return secp256k1.ToPrivateKey(b)
+}
+
+func main() {
+	if len(os.Args) < 2 {
+		usage()
+	}
+	switch os.Args[1] {
+	case "version", "-v", "--version":
+		fmt.Println(banner)
+		fmt.Println("9chain-a1-cli/0.1.0 (node 9chaingo)")
+	case "info":
+		cmdInfo(os.Args[2:])
+	case "l1":
+		cmdL1(os.Args[2:])
+	case "help", "-h", "--help":
+		usage()
+	default:
+		fmt.Fprintf(os.Stderr, "Lệnh không rõ: %s\n", os.Args[1])
+		usage()
+	}
+}
+
+func usage() {
+	fmt.Fprintln(os.Stderr, banner)
+	fmt.Fprintln(os.Stderr, `
+Cách dùng:
+  9chain-a1-cli version
+  9chain-a1-cli info      --uri <node>
+  9chain-a1-cli l1 create --uri <node> --genesis <file> [--name <ten>] [--vmid <id>]
+                          [--validator-weight N] [--validator-duration 720h] [--no-validators]
+  9chain-a1-cli l1 list   --uri <node>`)
+	os.Exit(2)
+}
+
+// ---------- HTTP JSON-RPC helper ----------
+func rpc(uri, path, method string, params any) (json.RawMessage, error) {
+	body, _ := json.Marshal(map[string]any{
+		"jsonrpc": "2.0", "id": 1, "method": method, "params": params,
+	})
+	resp, err := http.Post(uri+path, "application/json", bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	var out struct {
+		Result json.RawMessage `json:"result"`
+		Error  *struct {
+			Message string `json:"message"`
+		} `json:"error"`
+	}
+	if err := json.Unmarshal(raw, &out); err != nil {
+		return nil, fmt.Errorf("phản hồi không hợp lệ: %s", string(raw))
+	}
+	if out.Error != nil {
+		return nil, fmt.Errorf("%s", out.Error.Message)
+	}
+	return out.Result, nil
+}
+
+// ---------- info ----------
+func cmdInfo(args []string) {
+	fs := flag.NewFlagSet("info", flag.ExitOnError)
+	uri := fs.String("uri", "http://localhost:9650", "node API URI")
+	fs.Parse(args)
+
+	ver, err := rpc(*uri, "/ext/info", "info.getNodeVersion", nil)
+	fail(err, "info.getNodeVersion")
+	var v struct {
+		Version string `json:"version"`
+	}
+	json.Unmarshal(ver, &v)
+
+	peers, _ := rpc(*uri, "/ext/info", "info.peers", nil)
+	var p struct {
+		NumPeers string `json:"numPeers"`
+	}
+	json.Unmarshal(peers, &p)
+
+	vals, _ := rpc(*uri, "/ext/bc/P", "platform.getCurrentValidators", nil)
+	var vv struct {
+		Validators []json.RawMessage `json:"validators"`
+	}
+	json.Unmarshal(vals, &vv)
+
+	fmt.Println(banner)
+	fmt.Printf("  node       : %s\n", v.Version)
+	fmt.Printf("  peers      : %s\n", p.NumPeers)
+	fmt.Printf("  validators : %d\n", len(vv.Validators))
+	fmt.Printf("  uri        : %s\n", *uri)
+}
+
+// ---------- l1 ----------
+func cmdL1(args []string) {
+	if len(args) < 1 {
+		usage()
+	}
+	switch args[0] {
+	case "create":
+		l1Create(args[1:])
+	case "list":
+		l1List(args[1:])
+	default:
+		usage()
+	}
+}
+
+func l1List(args []string) {
+	fs := flag.NewFlagSet("l1 list", flag.ExitOnError)
+	uri := fs.String("uri", "http://localhost:9650", "node API URI")
+	fs.Parse(args)
+
+	res, err := rpc(*uri, "/ext/bc/P", "platform.getBlockchains", nil)
+	fail(err, "platform.getBlockchains")
+	var out struct {
+		Blockchains []struct {
+			ID       string `json:"id"`
+			Name     string `json:"name"`
+			SubnetID string `json:"subnetID"`
+			VMID     string `json:"vmID"`
+		} `json:"blockchains"`
+	}
+	json.Unmarshal(res, &out)
+	fmt.Printf("%-3s %-14s %-52s %s\n", "#", "NAME", "BLOCKCHAIN_ID", "VMID")
+	for i, b := range out.Blockchains {
+		fmt.Printf("%-3d %-14s %-52s %s\n", i+1, b.Name, b.ID, b.VMID)
+	}
+	fmt.Printf("Tổng: %d blockchain\n", len(out.Blockchains))
+}
+
+func l1Create(args []string) {
+	fs := flag.NewFlagSet("l1 create", flag.ExitOnError)
+	uri := fs.String("uri", "http://localhost:9650", "node API URI")
+	genesisPath := fs.String("genesis", "/9chain-a1/config/l1-evm-genesis.json", "genesis EVM cho L1")
+	name := fs.String("name", "9ChainA1L1", "tên L1 (chữ/số/space)")
+	vmid := fs.String("vmid", "pkqXszJe86D3xLomib9bLpXPfW7gr7FPhDAbg46p5iNjrn4mf", "VMID (love9evm)")
+	valWeight := fs.Uint64("validator-weight", 100, "trọng số mỗi validator của subnet")
+	valDuration := fs.Duration("validator-duration", 0, "thời hạn validate (0 = bám theo hạn của validator primary)")
+	noValidators := fs.Bool("no-validators", false, "KHÔNG đăng ký validator (chain sẽ không chốt được block)")
+	fs.Parse(args)
+
+	vmID, err := ids.FromString(*vmid)
+	fail(err, "parse vmid")
+	genesisBytes, err := os.ReadFile(*genesisPath)
+	fail(err, "đọc genesis")
+
+	// Khoá trả phí tạo subnet/chain trên P-Chain.
+	//
+	// Mặc định là ewoq — CHỈ dùng được cho mạng dev local, vì từ khi có phân bổ
+	// genesis thật (P0 #2) ewoq KHÔNG còn được cấp phát đồng nào. Trên testnet
+	// công khai phải truyền A1_CLI_KEY, nếu không mọi lệnh tạo chain đều lỗi
+	// "insufficient funds" mà thông báo lại chẳng nói gì về nguyên nhân.
+	//
+	// Khoá này cần LOVE9 THANH KHOẢN TRÊN P-CHAIN. Vật liệu genesis chỉ cấp
+	// thanh khoản trên X-Chain (InitialAmount) — phần P-Chain đều bị khoá
+	// (UnlockSchedule). Nên phải chuyển X→P trước bằng ví X/P.
+	key := genesis.EWOQKey
+	usingEwoq := true
+	if ks := os.Getenv("A1_CLI_KEY"); ks != "" {
+		k, err := parsePrivateKey(ks)
+		fail(err, "doc A1_CLI_KEY")
+		key = k
+		usingEwoq = false
+	}
+	if usingEwoq {
+		fmt.Fprintln(os.Stderr, "⚠️  dang dung khoa ewoq CONG KHAI (chi hop le tren mang dev local).")
+		fmt.Fprintln(os.Stderr, "    Tren testnet cong khai: dat A1_CLI_KEY=PrivateKey-... co LOVE9 tren P-Chain.")
+	}
+	kc := secp256k1fx.NewKeychain(key)
+	owner := &secp256k1fx.OutputOwners{Threshold: 1, Addrs: []ids.ShortID{key.Address()}}
+
+	ctx := context.Background()
+	fmt.Printf("→ đồng bộ ví P-Chain %s\n", *uri)
+	w, err := primary.MakePWallet(ctx, *uri, kc, primary.WalletConfig{})
+	fail(err, "ví")
+
+	t := time.Now()
+	subnetTx, err := w.IssueCreateSubnetTx(owner)
+	fail(err, "CreateSubnetTx")
+	subnetID := subnetTx.ID()
+	fmt.Printf("✓ subnet %s (%s)\n", subnetID, time.Since(t))
+
+	w, err = primary.MakePWallet(ctx, *uri, kc, primary.WalletConfig{SubnetIDs: []ids.ID{subnetID}})
+	fail(err, "đồng bộ lại ví")
+
+	// Đăng ký validator cho subnet. KHÔNG PHẢI tuỳ chọn: subnet mới đẻ ra có tập
+	// validator RỖNG, mà tập rỗng thì không ai bỏ phiếu nên chain không bao giờ
+	// chốt được block — RPC lên nhưng gửi giao dịch là treo. Chỉ `--track-subnets`
+	// thôi là chưa đủ; track là "tôi theo dõi", validate là "tôi bỏ phiếu".
+	if !*noValidators {
+		addSubnetValidators(*uri, w, subnetID, *valWeight, *valDuration)
+	} else {
+		fmt.Fprintln(os.Stderr, "⚠️  bỏ qua đăng ký validator — chain sẽ KHÔNG chốt được block.")
+	}
+
+	t = time.Now()
+	chainTx, err := w.IssueCreateChainTx(subnetID, genesisBytes, vmID, nil, *name)
+	fail(err, "CreateChainTx")
+	blockchainID := chainTx.ID()
+	fmt.Printf("✓ L1 EVM %s (%s)\n", blockchainID, time.Since(t))
+
+	fmt.Println("----------------------------------------------------------------")
+	fmt.Printf("SUBNET_ID=%s\n", subnetID)
+	fmt.Printf("BLOCKCHAIN_ID=%s\n", blockchainID)
+	fmt.Println("Kế tiếp: track subnet + restart node (dùng: 9chain-a1 l1 up <SUBNET_ID>)")
+}
+
+// addSubnetValidators đăng ký MỌI validator của primary network làm validator của
+// subnet vừa tạo. Đây là bước biến "subnet đã tồn tại trên P-Chain" thành "chain
+// chạy được".
+//
+// Ràng buộc của avalanchego (hậu Durango) đã trả giá để biết:
+//   - validator của subnet BẮT BUỘC đang là validator của primary network;
+//   - thời điểm bắt đầu bị bỏ qua (lấy timestamp của chain), nhưng thời hạn phải
+//     ≥ MinStakeDuration (24h) và KHÔNG được vượt quá hạn của chính validator đó
+//     trên primary network — vượt là tx bị từ chối.
+//
+// Nên mặc định lấy đúng hạn primary trừ hao 1 phút. Một node lỗi không được làm
+// hỏng cả lượt tạo chain: chỉ cần đủ số phiếu, nên lỗi lẻ chỉ cảnh báo.
+func addSubnetValidators(uri string, w pwallet.Wallet, subnetID ids.ID, weight uint64, duration time.Duration) {
+	res, err := rpc(uri, "/ext/bc/P", "platform.getCurrentValidators", map[string]any{})
+	fail(err, "platform.getCurrentValidators")
+	var cur struct {
+		Validators []struct {
+			NodeID  string `json:"nodeID"`
+			EndTime string `json:"endTime"`
+		} `json:"validators"`
+	}
+	fail(json.Unmarshal(res, &cur), "đọc danh sách validator")
+	if len(cur.Validators) == 0 {
+		fail(fmt.Errorf("primary network không có validator nào"), "validator")
+	}
+
+	added := 0
+	for _, v := range cur.Validators {
+		nodeID, err := ids.NodeIDFromString(v.NodeID)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "  bỏ qua %s: nodeID không đọc được: %v\n", v.NodeID, err)
+			continue
+		}
+		primaryEnd, err := strconv.ParseUint(v.EndTime, 10, 64)
+		if err != nil {
+			fmt.Fprintf(os.Stderr, "  bỏ qua %s: endTime không đọc được: %v\n", v.NodeID, err)
+			continue
+		}
+		// Trừ hao 1 phút: P-Chain tiến timestamp trong lúc ta còn đang ký, bằng
+		// đúng hạn primary là chạm biên và bị từ chối.
+		end := primaryEnd - 60
+		if duration > 0 {
+			if want := uint64(time.Now().Add(duration).Unix()); want < end {
+				end = want
+			}
+		}
+		if end <= uint64(time.Now().Unix())+minSubnetStakeSeconds {
+			fmt.Fprintf(os.Stderr, "  bỏ qua %s: hạn còn lại dưới 24h\n", v.NodeID)
+			continue
+		}
+		if _, err := w.IssueAddSubnetValidatorTx(&txs.SubnetValidator{
+			Validator: txs.Validator{NodeID: nodeID, End: end, Wght: weight},
+			Subnet:    subnetID,
+		}); err != nil {
+			fmt.Fprintf(os.Stderr, "  ⚠️  %s: %v\n", v.NodeID, err)
+			continue
+		}
+		added++
+		fmt.Printf("✓ validator %s (trọng số %d)\n", nodeID, weight)
+	}
+	if added == 0 {
+		fail(fmt.Errorf("không đăng ký được validator nào — chain sẽ không chốt được block"), "validator")
+	}
+	fmt.Printf("✓ %d/%d validator đã đăng ký cho subnet\n", added, len(cur.Validators))
+}
+
+func fail(err error, ctx string) {
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "LỖI %s: %v\n", ctx, err)
+		os.Exit(1)
+	}
+}
