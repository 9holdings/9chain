+// xp-wallet — ví DEV cho X-Chain & P-Chain của 9Chain-A1 (MetaMask chỉ lo EVM).
+// Xem số dư X/P, gửi LOVE9 trên X, và cross-chain X<->P.
+//
+// ⚠️ Ví DEV: khoá do server giữ (env WALLET_KEY, mặc định ewoq). CHỈ testnet.
+//
+// Env: WALLET_URI (mặc định http://localhost:9650), WALLET_KEY (PrivateKey-... ),
+//      PORT (8090)
+package main
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"net/http"
+	"os"
+	"strconv"
+
+	"github.com/ava-labs/avalanchego/genesis"
+	"github.com/ava-labs/avalanchego/ids"
+	"github.com/ava-labs/avalanchego/utils/constants"
+	"github.com/ava-labs/avalanchego/utils/crypto/secp256k1"
+	"github.com/ava-labs/avalanchego/utils/formatting/address"
+	"github.com/ava-labs/avalanchego/utils/units"
+	"github.com/ava-labs/avalanchego/vms/components/avax"
+	"github.com/ava-labs/avalanchego/vms/secp256k1fx"
+	"github.com/ava-labs/avalanchego/wallet/subnet/primary"
+)
+
+var (
+	uri         string
+	key         *secp256k1.PrivateKey
+	kc          *secp256k1fx.Keychain
+	hrp         string
+	xAddr       string
+	pAddr       string
+	avaxAssetID ids.ID
+)
+
+func env(k, d string) string {
+	if v := os.Getenv(k); v != "" {
+		return v
+	}
+	return d
+}
+
+func mkWallet(ctx context.Context) (*primary.Wallet, error) {
+	return primary.MakeWallet(ctx, uri, kc, kc, primary.WalletConfig{})
+}
+
+func rpc(path, method string, params any) (json.RawMessage, error) {
+	body, _ := json.Marshal(map[string]any{"jsonrpc": "2.0", "id": 1, "method": method, "params": params})
+	resp, err := http.Post(uri+path, "application/json", bytes.NewReader(body))
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	raw, _ := io.ReadAll(resp.Body)
+	var out struct {
+		Result json.RawMessage `json:"result"`
+		Error  *struct{ Message string } `json:"error"`
+	}
+	if err := json.Unmarshal(raw, &out); err != nil {
+		return nil, fmt.Errorf("resp: %s", raw)
+	}
+	if out.Error != nil {
+		return nil, fmt.Errorf("%s", out.Error.Message)
+	}
+	return out.Result, nil
+}
+
+func send(w http.ResponseWriter, code int, obj any) {
+	w.Header().Set("content-type", "application/json")
+	w.WriteHeader(code)
+	json.NewEncoder(w).Encode(obj)
+}
+
+// LOVE9 (integer) -> nAVAX
+func toNano(s string) (uint64, error) {
+	f, err := strconv.ParseFloat(s, 64)
+	if err != nil || f <= 0 {
+		return 0, fmt.Errorf("số lượng không hợp lệ")
+	}
+	return uint64(f * float64(units.Avax)), nil
+}
+
+func toShortID(xOrPAddr string) (ids.ShortID, error) {
+	_, _, b, err := address.Parse(xOrPAddr)
+	if err != nil {
+		return ids.ShortID{}, err
+	}
+	return ids.ToShortID(b)
+}
+
+func main() {
+	uri = env("WALLET_URI", "http://localhost:9650")
+	keyStr := env("WALLET_KEY", "")
+	if keyStr == "" {
+		key = genesis.EWOQKey
+	} else {
+		key = &secp256k1.PrivateKey{}
+		if err := key.UnmarshalText([]byte(keyStr)); err != nil {
+			fmt.Fprintln(os.Stderr, "WALLET_KEY lỗi:", err)
+			os.Exit(1)
+		}
+	}
+	kc = secp256k1fx.NewKeychain(key)
+
+	// Lấy context (networkID, avaxAssetID) qua 1 lần sync ví.
+	ctx := context.Background()
+	w, err := mkWallet(ctx)
+	if err != nil {
+		fmt.Fprintln(os.Stderr, "không kết nối được node:", err)
+		os.Exit(1)
+	}
+	xctx := w.X().Builder().Context()
+	avaxAssetID = xctx.AVAXAssetID
+	hrp = constants.GetHRP(xctx.NetworkID)
+	bech, _ := address.FormatBech32(hrp, key.Address().Bytes())
+	xAddr, pAddr = "X-"+bech, "P-"+bech
+
+	http.HandleFunc("/", func(rw http.ResponseWriter, r *http.Request) {
+		rw.Header().Set("content-type", "text/html; charset=utf-8")
+		rw.Write([]byte(page))
+	})
+	http.HandleFunc("/api/info", handleInfo)
+	http.HandleFunc("/api/send-x", handleSendX)
+	http.HandleFunc("/api/x-to-p", handleXtoP)
+	http.HandleFunc("/api/p-to-x", handlePtoX)
+
+	port := env("PORT", "8090")
+	fmt.Printf("9Chain-A1 · Ví X/P @ http://localhost:%s\n  X=%s\n  P=%s\n  asset=%s\n", port, xAddr, pAddr, avaxAssetID)
+	http.ListenAndServe(":"+port, nil)
+}
+
+func handleInfo(rw http.ResponseWriter, r *http.Request) {
+	xb, _ := rpc("/ext/bc/X", "avm.getBalance", map[string]any{"address": xAddr, "assetID": avaxAssetID.String()})
+	pb, _ := rpc("/ext/bc/P", "platform.getBalance", map[string]any{"addresses": []string{pAddr}})
+	var xr struct{ Balance string `json:"balance"` }
+	var pr struct{ Balance string `json:"balance"` }
+	json.Unmarshal(xb, &xr)
+	json.Unmarshal(pb, &pr)
+	send(rw, 200, map[string]any{
+		"xAddr": xAddr, "pAddr": pAddr,
+		"xBalance": nanoToMeta(xr.Balance), "pBalance": nanoToMeta(pr.Balance),
+		"asset": avaxAssetID.String(),
+	})
+}
+
+func nanoToMeta(s string) string {
+	n, _ := strconv.ParseUint(s, 10, 64)
+	return strconv.FormatFloat(float64(n)/float64(units.Avax), 'f', -1, 64)
+}
+
+func readBody(r *http.Request) map[string]string {
+	m := map[string]string{}
+	b, _ := io.ReadAll(r.Body)
+	json.Unmarshal(b, &m)
+	return m
+}
+
+func handleSendX(rw http.ResponseWriter, r *http.Request) {
+	m := readBody(r)
+	amt, err := toNano(m["amount"])
+	if err != nil {
+		send(rw, 400, map[string]string{"error": err.Error()})
+		return
+	}
+	to, err := toShortID(m["to"])
+	if err != nil {
+		send(rw, 400, map[string]string{"error": "địa chỉ X không hợp lệ"})
+		return
+	}
+	w, err := mkWallet(context.Background())
+	if err != nil {
+		send(rw, 500, map[string]string{"error": err.Error()})
+		return
+	}
+	tx, err := w.X().IssueBaseTx([]*avax.TransferableOutput{{
+		Asset: avax.Asset{ID: avaxAssetID},
+		Out: &secp256k1fx.TransferOutput{
+			Amt:          amt,
+			OutputOwners: secp256k1fx.OutputOwners{Threshold: 1, Addrs: []ids.ShortID{to}},
+		},
+	}})
+	if err != nil {
+		send(rw, 500, map[string]string{"error": err.Error()})
+		return
+	}
+	send(rw, 200, map[string]string{"txID": tx.ID().String()})
+}
+
+func owner() *secp256k1fx.OutputOwners {
+	return &secp256k1fx.OutputOwners{Threshold: 1, Addrs: []ids.ShortID{key.Address()}}
+}
+
+func handleXtoP(rw http.ResponseWriter, r *http.Request) {
+	amt, err := toNano(readBody(r)["amount"])
+	if err != nil {
+		send(rw, 400, map[string]string{"error": err.Error()})
+		return
+	}
+	w, err := mkWallet(context.Background())
+	if err != nil {
+		send(rw, 500, map[string]string{"error": err.Error()})
+		return
+	}
+	exp, err := w.X().IssueExportTx(constants.PlatformChainID, []*avax.TransferableOutput{{
+		Asset: avax.Asset{ID: avaxAssetID},
+		Out:   &secp256k1fx.TransferOutput{Amt: amt, OutputOwners: *owner()},
+	}})
+	if err != nil {
+		send(rw, 500, map[string]string{"error": "export X: " + err.Error()})
+		return
+	}
+	xChainID := w.X().Builder().Context().BlockchainID
+	imp, err := w.P().IssueImportTx(xChainID, owner())
+	if err != nil {
+		send(rw, 500, map[string]string{"error": "import P: " + err.Error(), "exportTx": exp.ID().String()})
+		return
+	}
+	send(rw, 200, map[string]string{"exportTx": exp.ID().String(), "importTx": imp.ID().String()})
+}
+
+func handlePtoX(rw http.ResponseWriter, r *http.Request) {
+	amt, err := toNano(readBody(r)["amount"])
+	if err != nil {
+		send(rw, 400, map[string]string{"error": err.Error()})
+		return
+	}
+	w, err := mkWallet(context.Background())
+	if err != nil {
+		send(rw, 500, map[string]string{"error": err.Error()})
+		return
+	}
+	xChainID := w.X().Builder().Context().BlockchainID
+	exp, err := w.P().IssueExportTx(xChainID, []*avax.TransferableOutput{{
+		Asset: avax.Asset{ID: avaxAssetID},
+		Out:   &secp256k1fx.TransferOutput{Amt: amt, OutputOwners: *owner()},
+	}})
+	if err != nil {
+		send(rw, 500, map[string]string{"error": "export P: " + err.Error()})
+		return
+	}
+	imp, err := w.X().IssueImportTx(constants.PlatformChainID, owner())
+	if err != nil {
+		send(rw, 500, map[string]string{"error": "import X: " + err.Error(), "exportTx": exp.ID().String()})
+		return
+	}
+	send(rw, 200, map[string]string{"exportTx": exp.ID().String(), "importTx": imp.ID().String()})
+}
+
