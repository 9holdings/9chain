+// create-l1 — tạo 1 L1 EVM (subnet-evm/love9evm) trên mạng 9Chain-A1 đang chạy.
+//
+// Dùng khoá ewoq (test) để: (1) CreateSubnet, (2) CreateChain với genesis EVM.
+// In ra subnetID, blockchainID và RPC endpoint.
+//
+// Chạy (từ golang container gắn vào network của compose):
+//   A1_URI=http://9chain-a1-node:9650 \
+//   A1_L1_GENESIS=/l1-evm-genesis.json \
+//   go run ./9chain-a1-tools/create-l1
+//
+// ⚠️ ewoq là khoá test công khai — chỉ dùng cho PoC/dev.
+package main
+
+import (
+	"context"
+	"log"
+	"os"
+	"time"
+
+	"github.com/ava-labs/avalanchego/genesis"
+	"github.com/ava-labs/avalanchego/ids"
+	"github.com/ava-labs/avalanchego/vms/secp256k1fx"
+	"github.com/ava-labs/avalanchego/wallet/subnet/primary"
+)
+
+func env(k, def string) string {
+	if v := os.Getenv(k); v != "" {
+		return v
+	}
+	return def
+}
+
+func main() {
+	uri := env("A1_URI", "http://localhost:9650")
+	genesisPath := env("A1_L1_GENESIS", "/l1-evm-genesis.json")
+	vmIDStr := env("LOVE9EVM_VMID", "pkqXszJe86D3xLomib9bLpXPfW7gr7FPhDAbg46p5iNjrn4mf")
+	chainName := env("A1_L1_NAME", "9ChainA1L1") // tên chỉ nhận chữ/số/space
+
+	vmID, err := ids.FromString(vmIDStr)
+	if err != nil {
+		log.Fatalf("VMID không hợp lệ: %s", err)
+	}
+	genesisBytes, err := os.ReadFile(genesisPath)
+	if err != nil {
+		log.Fatalf("không đọc được genesis EVM %q: %s", genesisPath, err)
+	}
+
+	key := genesis.EWOQKey
+	kc := secp256k1fx.NewKeychain(key)
+	owner := &secp256k1fx.OutputOwners{
+		Threshold: 1,
+		Addrs:     []ids.ShortID{key.Address()},
+	}
+
+	ctx := context.Background()
+	log.Printf("đồng bộ ví P-Chain tại %s ...", uri)
+	wallet, err := primary.MakePWallet(ctx, uri, kc, primary.WalletConfig{})
+	if err != nil {
+		log.Fatalf("khởi tạo ví thất bại (ewoq có UTXO trên P-Chain không?): %s", err)
+	}
+
+	// 1) Tạo subnet do ewoq sở hữu.
+	t0 := time.Now()
+	createSubnetTx, err := wallet.IssueCreateSubnetTx(owner)
+	if err != nil {
+		log.Fatalf("CreateSubnetTx thất bại: %s", err)
+	}
+	subnetID := createSubnetTx.ID()
+	log.Printf("✓ subnet mới: %s (%s)", subnetID, time.Since(t0))
+
+	// Ví cần biết subnetID để ký CreateChainTx -> đồng bộ lại có đăng ký subnet.
+	wallet, err = primary.MakePWallet(ctx, uri, kc, primary.WalletConfig{
+		SubnetIDs: []ids.ID{subnetID},
+	})
+	if err != nil {
+		log.Fatalf("đồng bộ lại ví với subnet thất bại: %s", err)
+	}
+
+	// 2) Tạo blockchain EVM trên subnet đó.
+	t1 := time.Now()
+	createChainTx, err := wallet.IssueCreateChainTx(subnetID, genesisBytes, vmID, nil, chainName)
+	if err != nil {
+		log.Fatalf("CreateChainTx thất bại: %s", err)
+	}
+	blockchainID := createChainTx.ID()
+	log.Printf("✓ L1 EVM mới: %s (%s)", blockchainID, time.Since(t1))
+
+	log.Printf("========================================================")
+	log.Printf(" SUBNET_ID      = %s", subnetID)
+	log.Printf(" BLOCKCHAIN_ID  = %s", blockchainID)
+	log.Printf(" RPC (nội bộ)   = %s/ext/bc/%s/rpc", uri, blockchainID)
+	log.Printf(" RPC (host)     = http://localhost:9650/ext/bc/%s/rpc", blockchainID)
+	log.Printf("========================================================")
+	log.Printf("LƯU Ý: node phải track subnet này. Thêm vào cấu hình:")
+	log.Printf("  --track-subnets=%s  rồi khởi động lại node.", subnetID)
+}
