+// ═══ P2P RA INTERNET (M3) ═══
+//
+// Mặc định (`A1_P2P_MODE` không đặt) netgen sinh y hệt như trước: `--public-ip` là
+// IP nội bộ docker (172.28.0.1x) và KHÔNG node nào publish 9651. Nghĩa là P2P sống
+// trọn trong bridge docker — 5 node thấy nhau, **không máy nào ngoài Internet vào
+// được**. Đó là lý do HANDOFF cấm quảng bá "chạy node cùng chúng tôi".
+//
+// Bật `A1_P2P_MODE=ipv6` thì mỗi node nhận một địa chỉ IPv6 toàn cục (GUA) cắt ra
+// từ khối của máy chủ, khai đúng địa chỉ đó làm `--public-ip`, và **không cần
+// publish cổng**: container có địa chỉ công khai của riêng nó nên nó tự đến được
+// từ Internet. Đây chính là điểm mạnh của IPv6 ở đây — 5 node trên một máy mà vẫn
+// mỗi node một địa chỉ, cổng 9651 tiêu chuẩn, không NAT, không giành cổng.
+//
+// 🔴 CÁI GIÁ PHẢI NÓI RÕ: `--public-ip` của avalanchego là MỘT địa chỉ, không phải
+// một danh sách (`config/config.go` → `ips.ParseAddrPort`, một giá trị). Khai IPv6
+// nghĩa là **peer chỉ có IPv4 không kết nối vào được**. Ta vẫn gọi RA họ được,
+// nhưng họ không gọi VÀO được — với một testnet mời cộng đồng chạy node thì đó là
+// loại bỏ phần lớn người muốn tham gia. Lựa chọn thay thế (IPv4 + mỗi node một
+// `--staking-port` 9651..965N + publish từng cổng) đến được 100% Internet nhưng
+// phải chịu NAT vòng lại giữa 5 node cùng máy. Đây là quyết định về ĐỐI TƯỢNG
+// người dùng, không phải về kỹ thuật — xem BLOCKERS H-7, David chọn.
+const (
+	p2pDocker = "docker" // mặc định: P2P chỉ trong bridge docker (như trước M3)
+	p2pIPv6   = "ipv6"   // mỗi node một GUA IPv6, ra thẳng Internet
+)
+
+func env(k, def string) string {
+	if v := os.Getenv(k); v != "" {
+		return v
+	}
+	return def
+}
+func atoi(s string, def int) int {
+	if n, err := strconv.Atoi(s); err == nil {
+		return n
+	}
+	return def
+}
+func must(err error, msg string) {
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "FATAL %s: %v\n", msg, err)
+		os.Exit(1)
+	}
+}
