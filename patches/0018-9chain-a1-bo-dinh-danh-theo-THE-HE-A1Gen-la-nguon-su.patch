+++ b/9chain-a1-tools/netgen/identity.go
@@ -0,0 +1,137 @@
+package main
+
+// ═══════════════════════════════════════════════════════════════════════════════
+// CỔNG BỘ ĐỊNH DANH — `A1Gen` là nguồn sự thật, bốn thứ còn lại phải suy đúng từ nó
+// ═══════════════════════════════════════════════════════════════════════════════
+//
+// David chốt bộ định danh `2026-08-27` (D-076). Vấn đề nó giải **không phải** "chọn số
+// nào" — mà là: `networkID`, tên mạng, và khối `chainId` của L1 **phải đổi cùng nhau ở
+// mỗi thế hệ**, và trước lượt này **không có gì bắt chúng đổi cùng nhau**.
+//
+// Ba lần trong ngày `27/08` dự án này vấp đúng lớp lỗi *"hai thứ phải khớp mà không ai
+// bắt chúng khớp"*: nhánh `web-home` lệch `main` 168 dòng ở tệp đang chạy · cổng deploy
+// chạy trên server mà chưa vào nguồn · hai phiên cùng đánh số một quyết định. Cổng này
+// tồn tại để lớp lỗi đó **không** lặp lại ở chỗ đắt nhất — lớp genesis, nơi không có
+// lần thứ hai.
+//
+// 🔴 Ô đắt nhất là ô `NetworkIDToHRP`. Trước patch 0013, `9001` KHÔNG có trong map đó
+// nên `GetHRP(9001)` rơi xuống `FallbackHRP` — tiền tố `love9` của MỌI địa chỉ P/X đã
+// phát ra ngoài **sống bằng nhánh dự phòng**, và không cổng nào bắt được. Đổi `A1ID` mà
+// quên cập nhật map là **dựng lại đúng lỗi đó**, ở đúng lượt không sửa lại được.
+
+import (
+	"fmt"
+	"os"
+
+	"github.com/ava-labs/avalanchego/genesis"
+	"github.com/ava-labs/avalanchego/utils/constants"
+)
+
+// Khối chainId của một thế hệ: [9_000_000_000 + gen×1_000_000 , +999_999].
+// Thế hệ 0 nâng sàn lên …010 để chừa chain mẹ …009 và chín số đệm.
+const (
+	chainIdGocKhoi = 9_000_000_000
+	chainIdMoiKhoi = 1_000_000
+	chainIdMe      = 9_000_000_009
+	chainIdSanGen0 = 9_000_000_010
+	chainIdTranHet = 9_999_999_999
+	theHeToiDa     = 999
+)
+
+func khoiChainIdCuaTheHe(gen uint32) (san, tran uint64) {
+	san = uint64(chainIdGocKhoi) + uint64(gen)*chainIdMoiKhoi
+	tran = san + chainIdMoiKhoi - 1
+	if gen == 0 {
+		san = chainIdSanGen0
+	}
+	return san, tran
+}
+
+// kiemBoDinhDanh dừng netgen nếu bất kỳ giá trị suy ra nào không khớp `A1Gen`.
+//
+// Nó KHÔNG cảnh báo rồi chạy tiếp: mọi thứ nó canh đều đi thẳng vào genesis, tức thứ
+// bất biến. Cái sửa được thì cảnh báo; cái khắc vĩnh viễn thì chặn — cùng lý lẽ với
+// cổng chainId của C-4.
+func kiemBoDinhDanh(networkID uint32) {
+	var loi []string
+	them := func(f string, a ...any) { loi = append(loi, fmt.Sprintf(f, a...)) }
+
+	gen := constants.A1Gen
+	laTap := networkID == constants.A1IDTap
+
+	if gen > theHeToiDa {
+		them("A1Gen = %d, vượt trần %d (dải chainId chỉ đủ %d thế hệ)", gen, theHeToiDa, theHeToiDa+1)
+	}
+
+	// 1) networkID phải suy đúng từ thế hệ, ở đúng băng.
+	muon := constants.A1IDGoc - gen
+	nhan := "mạng THẬT"
+	if laTap {
+		muon = constants.A1IDGocTap - gen
+		nhan = "mạng TẬP"
+	}
+	if networkID != muon {
+		them("networkID %d không khớp thế hệ: %s thế hệ %d phải là %d", networkID, nhan, gen, muon)
+	}
+
+	// 2) Tên mạng phải mang đúng thế hệ. Tên đi vào ĐƯỜNG DẪN DB — sai tên thì node
+	//    bootstrap vào một thư mục rỗng và KHÔNG báo lỗi.
+	tenMuon := fmt.Sprintf("9chain-a1-g%d", gen)
+	if laTap {
+		tenMuon = fmt.Sprintf("9chain-a1-tap-g%d", gen)
+	}
+	if ten := constants.NetworkName(networkID); ten != tenMuon {
+		them("NetworkName(%d) = %q, phải là %q", networkID, ten, tenMuon)
+	}
+
+	// 3) 🔴 networkID PHẢI có mặt trong NetworkIDToHRP — xem khối đầu tệp.
+	if _, co := constants.NetworkIDToHRP[networkID]; !co {
+		them("networkID %d KHÔNG có trong NetworkIDToHRP ⇒ HRP sẽ sống bằng FallbackHRP "+
+			"(đúng lỗi patch 0013 đã vá cho 9001). Thêm nó vào map.", networkID)
+	}
+	if hrp := constants.GetHRP(networkID); hrp != constants.A1HRP {
+		them("GetHRP(%d) = %q, phải là %q", networkID, hrp, constants.A1HRP)
+	}
+
+	// 4) Tham số kinh tế phải là của A1, không phải LocalParams mượn qua `default:`.
+	//    Đây là ô chống TRÀN NGƯỢC uint64 — xem genesis.LaMangA1.
+	if !genesis.LaMangA1(networkID) {
+		them("networkID %d không nằm trong dải A1 ⇒ genesis/params.go sẽ mượn LocalParams "+
+			"(trần cung 720 triệu) và genesis 4,3 tỷ sẽ TRÀN NGƯỢC uint64 khi phát thưởng", networkID)
+	}
+
+	// 5) Khối chainId của thế hệ phải nằm trọn trong dải David chốt, và không chạm chain mẹ.
+	san, tran := khoiChainIdCuaTheHe(gen)
+	if san <= chainIdMe {
+		them("khối chainId thế hệ %d có sàn %d ≤ chainId chain mẹ %d", gen, san, chainIdMe)
+	}
+	if tran > chainIdTranHet {
+		them("khối chainId thế hệ %d có trần %d, vượt dải %d", gen, tran, chainIdTranHet)
+	}
+	// Ba tính chất an toàn của D-076 — kiểm bằng số, không bằng niềm tin.
+	if len(fmt.Sprint(networkID)) != 9 {
+		them("networkID %d có %d chữ số, phải là 9 (để không nhìn nhầm với chainId 10 chữ số)",
+			networkID, len(fmt.Sprint(networkID)))
+	}
+	if uint64(networkID) >= san {
+		them("networkID %d KHÔNG nằm dưới sàn khối chainId %d ⇒ mất cổng bắt lỗi chép nhầm",
+			networkID, san)
+	}
+	if san <= 4_294_967_295 {
+		them("sàn khối chainId %d KHÔNG vượt trần uint32 ⇒ chép nhầm sang ô networkID sẽ đi lọt", san)
+	}
+
+	if len(loi) > 0 {
+		fmt.Fprintf(os.Stderr, "\nFATAL — BỘ ĐỊNH DANH KHÔNG KHỚP (A1Gen = %d)\n", gen)
+		for _, l := range loi {
+			fmt.Fprintf(os.Stderr, "  ✗ %s\n", l)
+		}
+		fmt.Fprintf(os.Stderr,
+			"\n  A1Gen là nguồn sự thật duy nhất. Sửa `utils/constants/network_ids.go`\n"+
+				"  cho mọi giá trị suy đúng từ nó, đừng sửa riêng một chỗ.\n\n")
+		os.Exit(1)
+	}
+
+	fmt.Printf("bộ định danh: thế hệ %d · networkID %d (%s) · tên %s · HRP %s · khối chainId L1 %d–%d\n",
+		gen, networkID, nhan, constants.NetworkName(networkID), constants.GetHRP(networkID), san, tran)
+}
diff --git a/9chain-a1-tools/netgen/main.go b/9chain-a1-tools/netgen/main.go
index 7ff43e4..c74a7ce 100644
--- a/9chain-a1-tools/netgen/main.go
+++ b/9chain-a1-tools/netgen/main.go
