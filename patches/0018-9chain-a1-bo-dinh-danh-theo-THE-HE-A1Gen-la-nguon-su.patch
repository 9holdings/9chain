-// netgen — Sinh toàn bộ vật liệu cho mạng 9Chain-A1 nhiều node THẬT:
-//   - 5 quỹ genesis, MỖI QUỸ MỘT KHOÁ RIÊNG (staking/foundation/ecosystem/faucet/team)
-//     theo bảng phân bổ trong allocation.go — codify của docs/TOKENOMICS.md
-//   - N bộ staking mỗi node: TLS cert+key (=> NodeID) và BLS signer key (=> PoP)
-//   - genesis.json (networkID 9001) với startTime ĐỘNG (tránh stake hết hạn)
-//   - docker-compose.multinode.yml gán static IP (avalanchego cần IP, không hostname)
-//   - keys.txt (TUYỆT MẬT) · faucet.env (chỉ khoá faucet) · allocation.md (công khai)
-//
-// KHÔNG dùng khoá ewoq công khai. Chạy trong golang container, ghi ra thư mục OUT.
-//
-// Env: N (số node, mặc định 5), OUT (thư mục ra, mặc định /out),
-//      NETWORK_ID (9001), SUBNET_PREFIX (172.28.0), BASE_OCTET (11)
-package main
-
-import (
-	"encoding/json"
-	"encoding/pem"
-	"fmt"
-	"math/big"
-	"os"
-	"path/filepath"
-	"strconv"
-	"strings"
-	"time"
-
-	"github.com/ava-labs/avalanchego/genesis"
-	"github.com/ava-labs/avalanchego/ids"
-	"github.com/ava-labs/avalanchego/staking"
-	"github.com/ava-labs/avalanchego/utils/constants"
-	"github.com/ava-labs/avalanchego/utils/crypto/bls/signer/localsigner"
-	"github.com/ava-labs/avalanchego/utils/crypto/secp256k1"
-	"github.com/ava-labs/avalanchego/vms/platformvm/signer"
-)
-
-type nodeInfo struct {
-	Index  int
-	NodeID ids.NodeID
-	IP     string // IPv4 nội bộ docker (luôn có — mọi node vẫn nói chuyện qua a1net)
-	IP6    string // GUA IPv6 công khai; RỖNG khi không bật chế độ ipv6 (M3)
-}
-
-// ═══ P2P RA INTERNET (M3) ═══
-//
-// Mặc định (`A1_P2P_MODE` không đặt) netgen sinh y hệt như trước: `--public-ip` là
-// IP nội bộ docker (172.28.0.1x) và KHÔNG node nào publish 9651. Nghĩa là P2P sống
-// trọn trong bridge docker — 5 node thấy nhau, **không máy nào ngoài Internet vào
-// được**. Đó là lý do HANDOFF cấm quảng bá "chạy node cùng chúng tôi".
-//
-// Bật `A1_P2P_MODE=ipv6` thì mỗi node nhận một địa chỉ IPv6 toàn cục (GUA) cắt ra
-// từ khối của máy chủ, khai đúng địa chỉ đó làm `--public-ip`, và **không cần
-// publish cổng**: container có địa chỉ công khai của riêng nó nên nó tự đến được
-// từ Internet. Đây chính là điểm mạnh của IPv6 ở đây — 5 node trên một máy mà vẫn
-// mỗi node một địa chỉ, cổng 9651 tiêu chuẩn, không NAT, không giành cổng.
-//
-// 🔴 CÁI GIÁ PHẢI NÓI RÕ: `--public-ip` của avalanchego là MỘT địa chỉ, không phải
-// một danh sách (`config/config.go` → `ips.ParseAddrPort`, một giá trị). Khai IPv6
-// nghĩa là **peer chỉ có IPv4 không kết nối vào được**. Ta vẫn gọi RA họ được,
-// nhưng họ không gọi VÀO được — với một testnet mời cộng đồng chạy node thì đó là
-// loại bỏ phần lớn người muốn tham gia. Lựa chọn thay thế (IPv4 + mỗi node một
-// `--staking-port` 9651..965N + publish từng cổng) đến được 100% Internet nhưng
-// phải chịu NAT vòng lại giữa 5 node cùng máy. Đây là quyết định về ĐỐI TƯỢNG
-// người dùng, không phải về kỹ thuật — xem BLOCKERS H-7, David chọn.
-const (
-	p2pDocker = "docker" // mặc định: P2P chỉ trong bridge docker (như trước M3)
-	p2pIPv6   = "ipv6"   // mỗi node một GUA IPv6, ra thẳng Internet
-)
-
-func env(k, def string) string {
-	if v := os.Getenv(k); v != "" {
-		return v
-	}
-	return def
-}
-func atoi(s string, def int) int {
-	if n, err := strconv.Atoi(s); err == nil {
-		return n
-	}
-	return def
-}
-func must(err error, msg string) {
-	if err != nil {
-		fmt.Fprintf(os.Stderr, "FATAL %s: %v\n", msg, err)
-		os.Exit(1)
-	}
-}
-
-func main() {
-	n := atoi(env("N", "5"), 5)
-	out := env("OUT", "/out")
-	networkID := uint32(atoi(env("NETWORK_ID", "9001"), 9001))
-	subnetPrefix := env("SUBNET_PREFIX", "172.28.0")
-	baseOctet := atoi(env("BASE_OCTET", "11"), 11)
-	// M3 — xem khối chú thích ở `p2pDocker`. Mặc định giữ nguyên hành vi cũ.
-	p2pMode := env("A1_P2P_MODE", p2pDocker)
-	// Khối /64 cắt ra cho mạng docker. Máy chủ hiện tại (139.99.145.13) được cấp
-	// nguyên một **/56** (`2402:1f00:8100:10d::/56`, đo 2026-08-25), nên cắt một /64
-	// cho docker là chuyện chia trong phần đã thuộc về mình — không đụng gì tới địa
-	// chỉ máy chủ đang dùng, và KHÔNG cần proxy NDP vì cả khối đã được định tuyến tới máy.
-	ipv6Subnet := env("A1_IPV6_SUBNET", "")
-	// Tiền tố để đánh địa chỉ từng node: node i ⇒ <base><baseOctet+i-1> (hệ 16).
-	// Tách khỏi `A1_IPV6_SUBNET` để địa chỉ node là số ĐỌC ĐƯỢC (…::b, ::c, …)
-	// thay vì để docker tự cấp — địa chỉ node phải ổn định vì nó đi vào
-	// `--bootstrap-ips` của các node khác và vào bản ghi DNS công khai.
-	ipv6Base := env("A1_IPV6_BASE", "")
-	if p2pMode == p2pIPv6 && (ipv6Subnet == "" || ipv6Base == "") {
-		// Chết ngay thay vì sinh ra một compose "gần đúng": mạng sinh sai địa chỉ
-		// P2P là loại lỗi chỉ lộ ra khi có người ngoài thử join, tức là muộn nhất.
-		fmt.Fprintln(os.Stderr, "FATAL A1_P2P_MODE=ipv6 đòi cả A1_IPV6_SUBNET và A1_IPV6_BASE")
-		os.Exit(1)
-	}
-	hrp := constants.GetHRP(networkID) // "love9" cho custom net
-
-	// 🔴 CHẶN networkID LẠ — patch 0013.
-	//
-	// `NETWORK_ID` là env, mà tham số kinh tế của 9Chain chỉ gắn vào **9001**
-	// (`genesis/params.go` → `case A1NetworkID`). Mọi networkID khác rơi vào nhánh
-	// `default:` và mượn `LocalParams`: trần cung 720 TRIỆU. Sinh một genesis phát
-	// hành 4,3 tỷ rồi chạy nó trên mạng đó là tràn ngược `uint64` ở
-	// `reward/calculator.go` — mạng lên sạch, RPC xanh, sai lệch chỉ lộ ở phần
-	// thưởng staking nhiều ngày sau.
