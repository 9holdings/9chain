+++ b/9chain-a1-tools/check-keys/main.go
@@ -1,4 +1,4 @@
-// kiem-khoa — PHÉP KIỂM KHÔI PHỤC cho bộ khoá quỹ genesis (O1).
+// check-keys — PHÉP KIỂM KHÔI PHỤC cho bộ khoá quỹ genesis (O1).
 //
 // 🔴 VÌ SAO CÓ CÔNG CỤ NÀY. O1 nằm mở nhiều ngày dưới dạng câu hỏi *"bản thứ hai có
 // tồn tại không"*. Đó là câu hỏi sai, và sai theo cách không ai phát hiện được: một
@@ -20,7 +20,7 @@
 //
 // Dùng:
