 	fmt.Printf("  networkID %d · mạng %q · HRP %q · %d quỹ\n\n", nid, constants.NetworkName(nid), hrp, len(khois))
 	if !constants.LaMangA1(nid) {
 		// Cảnh báo, không chặn: có thể ai đó đang kiểm một bộ khoá cũ một cách có ý thức.
