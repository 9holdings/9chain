-//	kiem-khoa <keys.txt> [-allocation allocation.md] [-network-id N]
+//	check-keys <keys.txt> [-allocation allocation.md] [-network-id N]
 //
 // `-allocation` bật thêm phép đối chiếu **chéo**: bảng CÔNG KHAI có khai đúng những
 // địa chỉ mà bộ khoá BÍ MẬT thật sự mở được không. Thiếu vế này thì hai tệp có thể
@@ -66,19 +66,19 @@ var (
 )
 
 func main() {
-	fs := flag.NewFlagSet("kiem-khoa", flag.ExitOnError)
+	fs := flag.NewFlagSet("check-keys", flag.ExitOnError)
 	allocPath := fs.String("allocation", "", "đối chiếu chéo với allocation.md (bảng công khai)")
 	networkID := fs.Uint("network-id", 0, "networkID để suy HRP (0 = đọc từ đầu keys.txt)")
 	fs.Parse(os.Args[1:])
 
 	if fs.NArg() < 1 {
-		fmt.Fprintln(os.Stderr, "Dùng: kiem-khoa <keys.txt> [-allocation allocation.md] [-network-id N]")
+		fmt.Fprintln(os.Stderr, "Dùng: check-keys <keys.txt> [-allocation allocation.md] [-network-id N]")
 		os.Exit(2)
 	}
 	duongDan := fs.Arg(0)
 
 	// 🔴 `flag` DỪNG PHÂN TÍCH ở đối số không phải cờ đầu tiên. Nên
-	// `kiem-khoa keys.txt -allocation x.md` chạy **trơn tru và bỏ qua `-allocation`** —
+	// `check-keys keys.txt -allocation x.md` chạy **trơn tru và bỏ qua `-allocation`** —
 	// tức bỏ luôn phép đối chiếu chéo, và bỏ trong im lặng. Đã dính đúng thế ở lượt
 	// chạy đầu tiên; chỉ thoát vì dòng cảnh báo cuối bài nói ra là nó chưa chạy.
 	// Nay chặn thẳng: một phép kiểm bị bỏ qua phải ồn hơn một phép kiểm thất bại.
@@ -86,7 +86,7 @@ func main() {
 		if strings.HasPrefix(thua, "-") {
 			fmt.Fprintf(os.Stderr,
 				"FATAL cờ %q đứng SAU đường dẫn nên bị bỏ qua.\n"+
-					"      Dùng: kiem-khoa [cờ...] <keys.txt>\n", thua)
+					"      Dùng: check-keys [cờ...] <keys.txt>\n", thua)
 			os.Exit(2)
 		}
 	}
@@ -112,7 +112,7 @@ func main() {
 	}
 	hrp := constants.GetHRP(nid)
 
-	fmt.Printf("kiem-khoa — %s\n", duongDan)
