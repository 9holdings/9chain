 		},
 	)
 	if err != nil {
diff --git a/utils/constants/network_ids.go b/utils/constants/network_ids.go
index 3c681ae..f57c43b 100644
--- a/utils/constants/network_ids.go
+++ b/utils/constants/network_ids.go
@@ -127,6 +127,27 @@ const (
 	// chịu lực.
 	A1HRP = "love9"
 
+	// A1AssetAlias — BÍ DANH tài sản gốc trên X-Chain của 9Chain-A1.
+	//
+	// 🔴 KHÔNG phải nhãn hiển thị. `genesis.FromConfig` lấy chuỗi này làm KHOÁ MAP
+	// tài sản, `vms/avm` đăng ký chính khoá đó làm alias thật, nên nó là cái tên mà
+	// **mọi công cụ hỏi X-Chain phải gọi đúng** (`avm.getAssetDescription`).
+	// Upstream dùng `"AVAX"`; A1 dùng `"LOVE9"` từ thế hệ g0.
+	//
+	// 🔴 NẰM TRONG BYTE GENESIS CỦA X-CHAIN ⇒ đổi được duy nhất ở một lượt sinh lại
+	// mạng, và đổi là đổi luôn assetID (assetID = ID của tx tạo tài sản).
+	//
+	// 🔴 VÌ SAO CÓ HẰNG NÀY: lượt g0 đổi khoá map sang `"LOVE9"` mà `wallet/chain/x`
+	// và `wallet/chain/c` vẫn hỏi cứng `"AVAX"` — `rebrand.sh` không chạm hai tệp đó.
+	// Hệ quả: **mọi công cụ dùng ví X hoặc C chết ngay khi mạng công khai lên g0**
+	// (`xp-wallet` báo `asset 'AVAX' not found`), và không cổng nào bắt được vì
+	// `9chain-a1-cli` đi đường P-Chain (`platform.getStakingAssetID`) nên vẫn xanh.
+	// Cùng họ với `FallbackHRP`: bản sắc sống bằng thứ không ai canh.
+	A1AssetAlias = "LOVE9"
+
+	// UpstreamAssetAlias — bí danh của mọi mạng KHÔNG thuộc A1 (mainnet/fuji/local).
+	UpstreamAssetAlias = "AVAX"
+
 	// FallbackHRP giữ nguyên `"love9"` (không trả về `"custom"` của upstream) —
 	// CỐ Ý, và nay chỉ là dây bảo hiểm thứ hai chứ không phải đường sống: mọi
 	// đường dùng thật đều đi qua `NetworkIDToHRP[A1ID]` ở trên. Đổi nó không còn
@@ -205,6 +226,22 @@ func LaMangA1(networkID uint32) bool {
 		(networkID <= A1IDGocTap && networkID > A1IDGocTap-bienDo-1)
 }
 
+// GetAssetAlias trả BÍ DANH tài sản gốc trên X-Chain của `networkID`.
+//
+// 🔴 CỐ Ý KHÔNG CÓ NHÁNH DỰ PHÒNG kiểu "thử LOVE9, hỏng thì thử AVAX". Một đường lui
+// như thế biến "hỏi sai tên" thành xanh và giấu luôn cái sai — đúng lớp lỗi đã trả giá
+// (`/moi/` che một trang 404 THẬT nhiều ngày). Ở đây tên được QUYẾT theo networkID:
+// sai băng thì hỏng ngay, và hỏng ở chỗ đọc được.
+//
+// Dùng `LaMangA1` chứ không dùng map như `NetworkIDToHRP`: bí danh phải đúng ở MỌI thế
+// hệ, kể cả thế hệ mà binary này chưa biết tên.
+func GetAssetAlias(networkID uint32) string {
+	if LaMangA1(networkID) {
+		return A1AssetAlias
+	}
+	return UpstreamAssetAlias
+}
+
 // GetHRP returns the Human-Readable-Part of bech32 addresses for a networkID
 func GetHRP(networkID uint32) string {
 	if hrp, ok := NetworkIDToHRP[networkID]; ok {
diff --git a/utils/constants/network_ids_test.go b/utils/constants/network_ids_test.go
index 212c41a..117e383 100644
--- a/utils/constants/network_ids_test.go
+++ b/utils/constants/network_ids_test.go
@@ -132,3 +132,42 @@ func TestNetworkID(t *testing.T) {
 		})
 	}
 }
+
+// TestGetAssetAlias — bí danh tài sản gốc trên X-Chain phải theo BĂNG MẠNG, không theo
+// một hằng đơn. Sinh ra sau sự cố g0: khoá map trong `genesis.FromConfig` đổi sang
+// `"LOVE9"` mà `wallet/chain/{x,c}` vẫn hỏi `"AVAX"` ⇒ mọi ví X/C chết lặng.
+//
+// 🔴 Bảng này có ca ĐỎ thật, không chỉ ca xanh: mạng upstream PHẢI ra `"AVAX"`. Nếu ai
+// đó "dọn dẹp" bằng cách trả `A1AssetAlias` cho mọi networkID thì fork mất khả năng
+// dựng lại genesis của mainnet/fuji, và không có gì khác báo điều đó.
+func TestGetAssetAlias(t *testing.T) {
+	tests := []struct {
+		name  string
+		id    uint32
+		alias string
+	}{
+		// Băng A1 — thế hệ hiện tại và các thế hệ chưa tồn tại.
+		{name: "A1 g0 (mạng thật)", id: A1IDGoc, alias: A1AssetAlias},
+		{name: "A1 g0 (mạng tập)", id: A1IDGocTap, alias: A1AssetAlias},
+		{name: "A1 thế hệ hiện tại", id: A1ID, alias: A1AssetAlias},
+		{name: "A1 g1 — chưa tồn tại", id: A1IDGoc - 1, alias: A1AssetAlias},
+		{name: "A1 g999 — đáy băng thật", id: A1IDGoc - 999, alias: A1AssetAlias},
+
+		// Ca ĐỎ: ngoài băng ⇒ phải là bí danh upstream.
+		{name: "mainnet", id: MainnetID, alias: UpstreamAssetAlias},
+		{name: "fuji", id: FujiID, alias: UpstreamAssetAlias},
+		{name: "local", id: LocalID, alias: UpstreamAssetAlias},
+		{name: "ngay dưới đáy băng thật", id: A1IDGoc - 1000, alias: UpstreamAssetAlias},
+		{name: "ngay dưới đáy băng tập", id: A1IDGocTap - 1000, alias: UpstreamAssetAlias},
+		{name: "9001 — networkID thế hệ TRƯỚC bộ định danh", id: 9001, alias: UpstreamAssetAlias},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			require.Equal(t, test.alias, GetAssetAlias(test.id))
+		})
+	}
+
+	// Hai bí danh KHÔNG được hoà về một — nếu bằng nhau thì mọi ca trên đều xanh mà
+	// bảng chẳng chứng minh gì.
+	require.NotEqual(t, A1AssetAlias, UpstreamAssetAlias)
+}
