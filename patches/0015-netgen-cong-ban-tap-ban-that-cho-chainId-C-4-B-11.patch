 	allocs := make([]string, 0, len(buckets)+1)
 	for _, b := range buckets {
 		if b.CChain == 0 {
@@ -379,7 +391,9 @@ func cChainGenesis(funds map[string]*fund, e *engraving) string {
 		extraData = e.CExtraData
