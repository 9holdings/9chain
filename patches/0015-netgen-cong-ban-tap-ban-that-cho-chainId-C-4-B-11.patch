diff --git a/9chain-a1-tools/netgen/chainid.go b/9chain-a1-tools/netgen/chainid.go
new file mode 100644
index 0000000..c51c08e
--- /dev/null
+++ b/9chain-a1-tools/netgen/chainid.go
@@ -0,0 +1,127 @@
+// CỔNG "BẢN TẬP ≠ BẢN THẬT" CHO chainId — C-4 (BLOCKERS B-11).
+//
+// ═══ Bất đối xứng đã tồn tại tới `2026-08-27` ═══
+// A1 dựng cổng *"bản tập ≠ bản thật"* rất kỹ cho **chữ khắc** (`A1_ENGRAVE_CONFIRM` + đối
+// chiếu C1 + báo cáo `engraving.md`). Cho **chainId** thì **không có cổng nào**:
+// `cChainGenesis` cắm cứng `9000000009`, nên **mọi mạng netgen sinh ra — tập hay thật —
+// đều mang chainId của mạng thật**, và netgen thậm chí không in ra con số đó.
+//
+// 🔴 Vì sao đó là chỗ đắt: `networkID` là chuyện nội bộ avalanchego. Thứ **ví người dùng
+// đọc** là `chainId`, và **EIP-155 buộc chữ ký vào `chainId`, không vào `networkID`**. Hai
+// mạng cùng `chainId` là hai mạng MetaMask không phân biệt được: cùng số, cùng tên, người
+// dùng thấy số dư 0 và không có gì báo lỗi; giao dịch đã ký của mạng này hợp lệ về mặt chữ
+// ký trên mạng kia.
+//
+// ⚠️ **Đừng trích mạnh hơn phép đo.** Hôm nay rủi ro thấp: netgen sinh **khoá mới mỗi lượt**
+// nên địa chỉ hai mạng khác nhau; cửa duy nhất là người tự import cùng một khoá vào cả hai.
+// Cái đắt là **bất đối xứng thiết kế**, không phải một vết thương đang chảy.
+//
+// ═══ Luật ═══
+//
+//	                 │ khắc chữ BẬT (lượt THẬT)      │ khắc chữ TẮT (lượt TẬP)
+//	─────────────────┼───────────────────────────────┼──────────────────────────────
+//	chainId = 9000000009 │ ✓ im lặng — đúng bản sắc  │ ⚠️ CẢNH BÁO LỚN (hoặc khai nhận)
+//	chainId ≠ 9000000009 │ 🔴 CHẶT — lượt thật phải  │ ✓ in ra, đây là đường đúng
+//	                     │    mang bản sắc thật      │
+//
+// **Vì sao lượt tập chỉ CẢNH BÁO chứ không CHẶN:** chặn cứng sẽ giết đường dev quen thuộc
+// `gen-network.sh 5`, và đổi chainId mặc định của mạng dev là đổi cấu hình MetaMask/faucet/
+// explorer của mọi người đang làm việc. Đây đúng lý lẽ đã dùng cho `canhBaoSelfBond` (§2
+// `NGAY-G-A1-CON-LAI`): chặn cứng mà không được gì thì chỉ tạo ra thói quen đi vòng.
+//
+// **Vì sao chiều ngược lại thì CHẶN:** khắc chữ lên một mạng mang chainId lạ là khắc vĩnh
+// viễn một bản sắc sai — không sửa được, và không ai phát hiện cho tới khi có người thật
+// thêm mạng vào ví. Bất đối xứng này là **cố ý**: cái sửa được thì cảnh báo, cái không sửa
+// được thì chặn.
+package main
+
+import (
+	"fmt"
+	"os"
+	"strconv"
+	"strings"
+)
+
+// chainIDThat — chainId của MẠNG THẬT 9Chain-A1. Chốt ở D-047 và nằm trong chuẩn đặt tên
+// `24/08` ⇒ đây là **bản sắc**, không phải tham số điều chỉnh được.
+const chainIDThat uint64 = 9_000_000_009
+
+// chainIDToiDa — EIP-2294: chainId phải vừa `MAX_SAFE_INTEGER` của JS, vì mọi ví và mọi
+// công cụ EVM đều đi qua JSON/JavaScript. Vượt ngưỡng này thì con số **im lặng bị làm
+// tròn** ở phía ví — không có lỗi nào, chỉ có một mạng khác.
+const chainIDToiDa uint64 = 9_007_199_254_740_990
+
+// chainIDTapKhaiNhan — giá trị phải khai để tắt cảnh báo "mạng tập mang chainId thật".
+//
+// Cố ý là một câu tiếng Việt dài chứ không phải `1`/`true`: nó nằm lại trong lịch sử shell
+// và trong log CI, nên người đọc lại thấy ngay lượt đó đã khai nhận điều gì. Một cờ mà gõ
+// nhầm cũng bật được là một cờ sẽ bị bật nhầm. (Cùng khuôn với `engraveDrillOptOut`.)
+const chainIDTapKhaiNhan = "toi-biet-mang-tap-nay-mang-chainid-that"
+
+// resolveChainID đọc `A1_CHAIN_ID` rồi áp bảng luật ở đầu tệp.
+// `khac` = lượt này có khắc chữ hay không, tức "đây có phải lượt THẬT không".
+func resolveChainID(khac bool) uint64 {
+	raw := strings.TrimSpace(env("A1_CHAIN_ID", ""))
+	id := chainIDThat
+	if raw != "" {
+		v, err := strconv.ParseUint(raw, 10, 64)
+		if err != nil || v == 0 {
+			fmt.Fprintf(os.Stderr, "FATAL A1_CHAIN_ID=%q khong doc duoc — can mot so nguyen duong.\n", raw)
+			os.Exit(1)
+		}
+		if v > chainIDToiDa {
+			fmt.Fprintf(os.Stderr,
+				"FATAL A1_CHAIN_ID=%d vuot tran EIP-2294 (%d).\n"+
+					"      Vuot nguong nay thi vi lam tron con so trong IM LANG — khong loi nao,\n"+
+					"      chi la mot mang khac voi mang ban dinh sinh.\n", v, chainIDToiDa)
+			os.Exit(1)
+		}
+		id = v
+	}
+
+	switch {
+	case id == chainIDThat && khac:
+		// Lượt thật, bản sắc thật. Đúng đường, không nói gì thêm ở đây —
+		// dòng tổng kết cuối vẫn in con số ra.
+
+	case id == chainIDThat && !khac:
+		if strings.TrimSpace(env("A1_CHAIN_ID_KHAI_NHAN", "")) == chainIDTapKhaiNhan {
+			fmt.Fprintf(os.Stderr, "⚠️  chainId: mang TAP nay mang chainId THAT (%d) — da khai nhan.\n", id)
+			break
+		}
+		fmt.Fprintln(os.Stderr, "")
+		fmt.Fprintln(os.Stderr, "============ chainId: MANG TAP DANG MANG SO CUA MANG THAT ============")
+		fmt.Fprintf(os.Stderr, "Luot nay KHONG khac chu ⇒ day la mot ban TAP.\n")
+		fmt.Fprintf(os.Stderr, "Nhung C-Chain cua no mang chainId %d — DUNG SO CUA MANG THAT.\n", id)
+		fmt.Fprintln(os.Stderr, "")
+		fmt.Fprintln(os.Stderr, "Vi doc chainId, KHONG doc networkID. EIP-155 buoc chu ky vao chainId.")
+		fmt.Fprintln(os.Stderr, "⇒ MetaMask khong phan biet duoc mang nay voi mang cong khai: cung so,")
+		fmt.Fprintln(os.Stderr, "   cung ten, nguoi dung thay so du 0 va khong co gi bao loi.")
+		fmt.Fprintln(os.Stderr, "")
+		fmt.Fprintln(os.Stderr, "Cach dung:")
+		fmt.Fprintln(os.Stderr, "  Mang tap : A1_CHAIN_ID=<so khac>   (vd 9000000909)")
+		fmt.Fprintf(os.Stderr, "  Neu CO Y : A1_CHAIN_ID_KHAI_NHAN=%s\n", chainIDTapKhaiNhan)
+		fmt.Fprintln(os.Stderr, "======================================================================")
+		fmt.Fprintln(os.Stderr, "")
+
+	case id != chainIDThat && khac:
+		// 🔴 CHẶN. Khắc vĩnh viễn một bản sắc sai là thứ không có đường lui.
+		fmt.Fprintln(os.Stderr, "")
+		fmt.Fprintln(os.Stderr, "============ chainId: LUOT THAT MANG SO CUA MANG TAP ============")
+		fmt.Fprintf(os.Stderr, "Luot nay CO khac chu ⇒ day la luot THAT.\n")
+		fmt.Fprintf(os.Stderr, "Nhung A1_CHAIN_ID=%d, khac chainId that %d.\n", id, chainIDThat)
+		fmt.Fprintln(os.Stderr, "")
+		fmt.Fprintln(os.Stderr, "Genesis la BAT BIEN. Khac chu len mot mang mang ban sac sai la khac")
+		fmt.Fprintln(os.Stderr, "vinh vien mot ban sac sai — khong sua duoc, va khong ai phat hien cho")
+		fmt.Fprintln(os.Stderr, "toi khi co nguoi that them mang vao vi.")
+		fmt.Fprintln(os.Stderr, "")
+		fmt.Fprintln(os.Stderr, "  Luot THAT: bo A1_CHAIN_ID di (mac dinh la so that).")
+		fmt.Fprintln(os.Stderr, "  Luot TAP : bo A1_ENGRAVE di.")
+		fmt.Fprintln(os.Stderr, "=================================================================")
+		os.Exit(1)
+
+	default: // id != chainIDThat && !khac — đường ĐÚNG cho một mạng tập
+		fmt.Fprintf(os.Stderr, "✓ chainId: %d (mang TAP, khac voi mang that %d)\n", id, chainIDThat)
+	}
+	return id
+}
diff --git a/9chain-a1-tools/netgen/main.go b/9chain-a1-tools/netgen/main.go
