 	gb, err := json.MarshalIndent(cfg, "", "  ")
@@ -305,6 +309,14 @@ FAUCET_ADDR=%s
 	fmt.Printf("  genesis.json · docker-compose.multinode.yml · allocation.md (cong khai)\n")
 	fmt.Printf("  keys.txt (TUYET MAT) · faucet.env (chi khoa faucet)\n")
 	fmt.Printf("  Tong phat hanh genesis: %s LOVE9\n", love9(totalGenesisSupply()))
+	// In chainId LUÔN LUÔN. Tới `27/08` netgen không in con số này ở đâu cả — nên không
+	// lượt sinh mạng nào để lại dấu vết về bản sắc mà nó vừa phát ra. Im lặng ở đây là
+	// cách một mạng tập đi ra ngoài dưới tên mạng thật mà không ai nhận ra.
+	if chainID == chainIDThat {
+		fmt.Printf("  C-Chain chainId: %d  <-- SO CUA MANG THAT\n", chainID)
+	} else {
+		fmt.Printf("  C-Chain chainId: %d  (mang TAP; so that la %d)\n", chainID, chainIDThat)
+	}
 	if eng == nil {
 		// In cả khi KHÔNG khắc. Im lặng ở đây là cách một lượt "thật" đi qua mà
 		// không ai nhận ra nó thiếu chữ khắc.
@@ -351,7 +363,7 @@ func pChainMessage(e *engraving) string {
 // Avalanche (khoá ewoq công khai giữ 50 triệu) còn sót trong đường boot của node dev.
 // Ai đi theo con trỏ cũ để sửa chữ khắc sẽ sửa một tệp không ai đọc, **và không có gì
 // báo lỗi**. Xem `docs/CORE-AUDIT-2026-08-27.md` §7b.
-func cChainGenesis(funds map[string]*fund, e *engraving) string {
