@@ -89,7 +90,20 @@ func must(err error, msg string) {
 func main() {
 	n := atoi(env("N", "5"), 5)
 	out := env("OUT", "/out")
-	networkID := uint32(atoi(env("NETWORK_ID", "9001"), 9001))
+	// 🔴 KHÔNG CÓ MẶC ĐỊNH. Tới `27/08` dòng này mặc định `9001` — networkID của thế hệ
+	// ĐÃ CHẾT, mà chính cổng bộ định danh bên dưới từ chối. Nên hành vi "chạy netgen
+	// trần thì dừng" là ĐÚNG nhưng đúng do TAI NẠN, và thông báo lỗi nói về một con số
+	// người dùng chưa từng gõ. Tệ hơn: chú thích đầu tệp khai mặc định là `constants.A1ID`
+	// — tức tài liệu mô tả một hành vi mà nếu ai đó "sửa cho khớp" thì `netgen` trần sẽ
+	// lặng lẽ sinh ra MẠNG THẬT. Nay bắt khai tường minh: chọn băng là một quyết định.
+	if env("NETWORK_ID", "") == "" {
+		fmt.Fprintf(os.Stderr,
+			"FATAL NETWORK_ID chưa đặt — chọn băng là một quyết định, không phải mặc định.\n"+
+				"      Mạng THẬT: NETWORK_ID=%d · mạng TẬP: NETWORK_ID=%d (thế hệ %d).\n",
+			constants.A1ID, constants.A1IDTap, constants.A1Gen)
+		os.Exit(1)
+	}
+	networkID := uint32(atoi(env("NETWORK_ID", ""), 0))
 	subnetPrefix := env("SUBNET_PREFIX", "172.28.0")
 	baseOctet := atoi(env("BASE_OCTET", "11"), 11)
 	// M3 — xem khối chú thích ở `p2pDocker`. Mặc định giữ nguyên hành vi cũ.
@@ -260,6 +274,11 @@ func main() {
 	compose := buildCompose(nodes, subnetPrefix, ipv6Subnet, networkID)
 	must(os.WriteFile(filepath.Join(out, "docker-compose.multinode.yml"), []byte(compose), 0o644), "write compose")
 
+	// ---- 4b) .env — ĐI KÈM compose, không phải phụ kiện ----
+	// Mọi biến trong compose có mặc định KÉM AN TOÀN HƠN. Thiếu .env thì mạng lên
+	// xanh với `--http-allowed-hosts=*`. Xem envfile.go.
+	tomTatEnv := vietEnvVanHanh(out, networkID)
+
 	// ---- 5) Xuất khoá của TỪNG quỹ (BÍ MẬT) ----
 	// keys.txt  = TẤT CẢ khoá -> giữ offline, KHÔNG BAO GIỜ lên server.
 	// faucet.env = CHỈ khoá faucet -> đây là file duy nhất được phép đưa lên server.
@@ -317,6 +336,10 @@ FAUCET_ADDR=%s
 	fmt.Printf("\n✓ Sinh xong %d node vào %s\n", n, out)
 	fmt.Printf("  genesis.json · docker-compose.multinode.yml · allocation.md (cong khai)\n")
 	fmt.Printf("  keys.txt (TUYET MAT) · faucet.env (chi khoa faucet)\n")
+	// In .env RA MÀN HÌNH, không chỉ ghi ra đĩa: giá trị của nó là thứ quyết định
+	// node công khai có phơi trần hay không, và `A1_CONFIG_DIR` là giá trị DUY NHẤT
+	// trong bộ này mà netgen không tự kiểm được.
+	fmt.Printf("  %s\n", tomTatEnv)
 	fmt.Printf("  Tong phat hanh genesis: %s LOVE9\n", love9(totalGenesisSupply()))
 	// In chainId LUÔN LUÔN. Tới `27/08` netgen không in con số này ở đâu cả — nên không
 	// lượt sinh mạng nào để lại dấu vết về bản sắc mà nó vừa phát ra. Im lặng ở đây là
