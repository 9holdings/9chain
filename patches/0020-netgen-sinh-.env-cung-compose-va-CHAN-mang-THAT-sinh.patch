index 0000000..33f5c0b
--- /dev/null
+++ b/9chain-a1-tools/netgen/envfile.go
@@ -0,0 +1,126 @@
+package main
+
+// .env — CẤU HÌNH VẬN HÀNH ĐI KÈM COMPOSE, và vì sao netgen phải tự sinh nó.
+//
+// 🔴 SỰ CỐ SUÝT XẢY RA `2026-08-27` (lượt re-genesis g0): netgen sinh
+// `docker-compose.multinode.yml` nhưng KHÔNG sinh `.env`. Compose tự nạp `.env` từ
+// thư mục chứa tệp compose, và mọi biến trong đó đều khai kèm **giá trị mặc định**:
+//
+//	--http-allowed-hosts=${A1_HTTP_ALLOWED_HOSTS:-*}
+//	ports: "${A1_API_BIND:-127.0.0.1}:9650:9650"
+//
+// ⇒ Thiếu `.env` thì mạng vẫn lên, 9/9 node xanh, không một dòng lỗi nào — nhưng bộ
+// lọc Host của node CÔNG KHAI mở thành `*`. Lượt g0 thoát chỉ vì có người nhớ chép
+// tay `.env` từ thư mục mạng cũ sang. **Trí nhớ không phải một cổng.**
+//
+// Cùng họ với mọi lỗi đắt nhất của repo này: thứ sai KHÔNG kêu. Và tệ hơn cả
+// `FallbackHRP` ở chỗ nhánh dự phòng ở đây là **nhánh kém an toàn hơn**, chứ không
+// phải chỉ là "một giá trị khác".
+//
+// ⚠️ NETGEN KHÔNG TỰ KIỂM ĐƯỢC `A1_CONFIG_DIR`. Nó chạy trong container và ghi ra
+// `/out`, còn đường dẫn đó được compose giải trên MÁY CHỦ, tương đối so với thư mục
+// chứa tệp compose. Nên nó chỉ chép lại giá trị được đưa vào (mặc định = đúng giá
+// trị mặc định của compose, tức không đổi hành vi so với khi không có `.env`) và IN
+// TO ra để người chạy nhìn thấy. Đừng thêm một phép kiểm giả vờ ở đây.
+
+import (
+	"fmt"
+	"os"
+	"path/filepath"
+
+	"github.com/ava-labs/avalanchego/utils/constants"
+)
+
+const (
+	// Mặc định phải TRÙNG giá trị mặc định trong compose — nếu lệch thì việc sinh
+	// `.env` tự nó trở thành một thay đổi hành vi âm thầm.
+	envConfigDirMacDinh = "../../9chain-a1-config"
+	envAPIBindMacDinh   = "127.0.0.1"
+	envAllowedMacDinh   = "localhost,127.0.0.1"
+)
+
+// vietEnvVanHanh sinh `<out>/.env` và trả về dòng tóm tắt để in.
+//
+// Ba biến đầu đọc từ môi trường của chính netgen, cùng TÊN với biến nó ghi ra —
+// người vận hành chỉ phải nhớ một bộ tên.
+func vietEnvVanHanh(out string, networkID uint32) string {
+	cfgDir := env("A1_CONFIG_DIR", envConfigDirMacDinh)
+	apiBind := env("A1_API_BIND", envAPIBindMacDinh)
+	allowed := env("A1_HTTP_ALLOWED_HOSTS", envAllowedMacDinh)
+
+	kiemPhoiTran(networkID, apiBind, allowed)
+
+	noiDung := fmt.Sprintf(`# 9Chain-A1 — cấu hình vận hành của mạng %d. NETGEN SINH RA, đừng viết tay vào đây.
+#
+# 🔴 TỆP NÀY LÀ MỘT CỔNG AN TOÀN, không phải tiện nghi. Compose tự nạp nó từ thư mục
+# chứa tệp compose, và MỌI biến dưới đây đều có mặc định KÉM AN TOÀN HƠN trong
+# compose (`+"`--http-allowed-hosts=${A1_HTTP_ALLOWED_HOSTS:-*}`"+`). Thiếu tệp này thì
+# mạng vẫn lên, 9/9 node vẫn xanh, và bộ lọc Host của node công khai mở thành `+"`*`"+`
+# — không một dòng lỗi nào báo cho ai biết.
+#
+# ⇒ Chạy compose từ thư mục KHÁC thì BẮT BUỘC `+"`--env-file <thu-muc-mang>/.env`"+`.
+# ⇒ Chép mạng sang máy khác thì chép CẢ tệp này.
+
+# Thư mục cấu hình mount vào node (chứa l1-evm-genesis.json).
+# ⚠️ netgen KHÔNG kiểm được giá trị này (nó giải trên máy chủ, không trong container).
+#    Bố cục server hiện tại: /home/ubuntu/9chain-a1/src/9chain-a1-config
+A1_CONFIG_DIR=%s
+
+# Địa chỉ host mà cổng RPC 9650 gắn vào. 127.0.0.1 = chỉ loopback, Caddy đứng trước.
+A1_API_BIND=%s
+
+# Bộ lọc header Host của avalanchego. KHÔNG để `+"`*`"+` trên mạng thật.
+A1_HTTP_ALLOWED_HOSTS=%s
+
+# Danh sách subnet mỗi node track. RỖNG là đúng với mạng vừa sinh: chưa có L1 nào.
+# Console tự ghi lại dòng này mỗi lần đẻ/thu hồi L1 — đừng sửa tay.
+A1_TRACK_SUBNETS=
+`, networkID, cfgDir, apiBind, allowed)
+
+	must(os.WriteFile(filepath.Join(out, ".env"), []byte(noiDung), 0o644), "write .env")
+	return fmt.Sprintf(".env: A1_CONFIG_DIR=%s · A1_API_BIND=%s · A1_HTTP_ALLOWED_HOSTS=%s",
+		cfgDir, apiBind, allowed)
+}
+
+// kiemPhoiTran — CỔNG: mạng THẬT không được sinh ra ở tư thế phơi trần.
+//
+// 🔴 Chỉ chặn ở băng THẬT. Mạng TẬP được phép mở, vì bài tập hay chạy sau một
+// explorer hoặc gọi từ máy khác — và đó cũng là ca ĐỎ/XANH đối xứng để kiểm chính
+// cổng này: cùng một tham số, băng thật phải DỪNG, băng tập phải CHO QUA.
+//
+// ⚠️ KHÔNG có cờ "tôi biết tôi đang làm gì". Một mạng thật cần mở Host filter là
+// một quyết định phải đi qua Caddy hoặc qua `--env-file` lúc `up`, không phải qua
+// một cờ nằm sẵn trong công cụ sinh mạng.
+func kiemPhoiTran(networkID uint32, apiBind, allowed string) {
+	if networkID == constants.A1IDTap {
+		if allowed == "*" || apiBind == "0.0.0.0" {
+			fmt.Fprintf(os.Stderr,
+				"⚠️  mạng TẬP: cho phép phơi trần (A1_API_BIND=%s A1_HTTP_ALLOWED_HOSTS=%s).\n"+
+					"    Cùng tham số này trên mạng THẬT sẽ bị chặn.\n", apiBind, allowed)
+		}
+		return
+	}
+
+	var loi []string
+	if allowed == "*" || allowed == "" {
+		loi = append(loi, fmt.Sprintf("A1_HTTP_ALLOWED_HOSTS = %q ⇒ node nhận mọi header Host. "+
+			"Đây đúng là mặc định mà tệp .env sinh ra để chặn.", allowed))
+	}
+	if apiBind == "0.0.0.0" || apiBind == "::" {
+		loi = append(loi, fmt.Sprintf("A1_API_BIND = %q ⇒ cổng RPC 9650 gắn ra MỌI giao diện mạng, "+
+			"đi vòng qua Caddy và qua mọi thứ Caddy đang canh.", apiBind))
+	}
+	if len(loi) == 0 {
+		return
+	}
+
+	fmt.Fprintf(os.Stderr, "\nFATAL — MẠNG THẬT (networkID %d) KHÔNG ĐƯỢC SINH RA Ở TƯ THẾ PHƠI TRẦN\n", networkID)
+	for _, l := range loi {
+		fmt.Fprintf(os.Stderr, "  ✗ %s\n", l)
+	}
+	fmt.Fprintf(os.Stderr,
+		"\n  Muốn mở thật thì mở lúc `docker compose up` bằng --env-file của riêng lượt đó,\n"+
+			"  đừng nướng nó vào vật liệu sinh mạng. Mạng TẬP (networkID %d) không bị chặn.\n\n",
+		constants.A1IDTap)
+	os.Exit(1)
+}
