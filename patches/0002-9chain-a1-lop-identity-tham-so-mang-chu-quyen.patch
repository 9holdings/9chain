diff --git a/genesis/genesis_9chain_a1.go b/genesis/genesis_9chain_a1.go
new file mode 100644
index 0000000..17086c9
--- /dev/null
+++ b/genesis/genesis_9chain_a1.go
@@ -0,0 +1,112 @@
+// 9Chain-A1 — tham số kinh tế CHỦ QUYỀN cho mạng LOVE9 (networkID 9001).
+//
+// Trước file này, mạng 9001 rơi vào nhánh `default:` của GetStakingConfig/GetTxFeeConfig
+// và mượn nguyên LocalParams của Avalanche — tức là 9Chain KHÔNG sở hữu tham số kinh tế
+// của chính mình. File này tách chúng ra thành A1Params để mọi thay đổi tokenomics
+// có một chỗ duy nhất, có chủ đích, và review được.
+//
+// ⚠️ MỌI số trong file này là CONSENSUS-CRITICAL: đổi = phải re-genesis toàn mạng
+// (wipe volume + sinh lại genesis.json). Không sửa nóng trên mạng đang chạy.
+//
+// File này KHÔNG bị scripts/rebrand.sh động tới (rebrand chỉ reset 4 file identity),
+// nên an toàn khi rebase upstream. Nhưng nhánh `case A1NetworkID:` trong params.go
+// thì phải kiểm tra lại sau mỗi lần rebase.
+package genesis
+
+import (
+	"time"
+
+	"github.com/ava-labs/avalanchego/utils/units"
+	"github.com/ava-labs/avalanchego/vms/components/gas"
+	"github.com/ava-labs/avalanchego/vms/platformvm/reward"
+	"github.com/ava-labs/avalanchego/vms/platformvm/validators/fee"
+)
+
+// A1NetworkID là networkID của 9Chain-A1.
+//
+// LƯU Ý: networkID Avalanche là uint32 (≤ 4,294,967,295) nên KHÔNG thể dùng
+// số nhận diện 9 tỷ của 9Chain ở đây. Số 9 tỷ (9000000009) là EVM chainId
+// của C-Chain, khai báo trong cChainGenesis của netgen — hai thứ khác nhau.
+const A1NetworkID uint32 = 9001
+
+// A1Params — tham số staking + phí của 9Chain-A1 (token LOVE9, 9 chữ số thập phân).
+//
+// Đơn vị: units.Avax = 1 LOVE9 = 1e9 nLOVE9 (nAVAX trong mã upstream).
+var A1Params = Params{
+	TxFeeConfig: TxFeeConfig{
+		// Phí cố định trên P/X-Chain: 0.001 LOVE9.
+		// Giữ thấp có chủ đích — A1 là mạng "đẻ L1", phí tạo subnet/chain
+		// không được là rào cản với builder.
+		CreateAssetTxFee: units.MilliAvax,
+		TxFee:            units.MilliAvax,
+
+		// Phí động (ACP-103). Giữ nguyên đường cong đã được Avalanche kiểm chứng:
+		// các hằng số này là kết quả tính toán consensus-critical, không tự chế.
+		DynamicFeeConfig: gas.Config{
+			Weights: gas.Dimensions{
+				gas.Bandwidth: 1,     // block tối đa ~1MB
+				gas.DBRead:    1_000, // tối đa 1,000 lượt đọc/block
+				gas.DBWrite:   1_000, // tối đa 1,000 lượt ghi/block
+				gas.Compute:   4,     // thời gian tính toán tối đa ~250ms/block
+			},
+			MaxCapacity:              1_000_000,
+			MaxPerSecond:             100_000, // nạp đầy lại sau 10s
+			TargetPerSecond:          50_000,  // mục tiêu = 1/2 max
+			MinPrice:                 1,
+			ExcessConversionConstant: 2_164_043, // gấp đôi mỗi 30s
+		},
+
+		// Phí duy trì validator L1 (ACP-77).
+		ValidatorFeeConfig: fee.Config{
+			Capacity:                 20_000,
+			Target:                   10_000,
+			MinPrice:                 gas.Price(1 * units.NanoAvax),
+			ExcessConversionConstant: 865_617, // gấp đôi mỗi phút
+		},
+	},
+
+	StakingConfig: StakingConfig{
+		// Uptime tối thiểu để được nhận thưởng.
+		// 80% — nới hơn mainnet Avalanche (ACP-267 dùng 90%) vì A1 là testnet
+		// công khai, validator cộng đồng chạy trên hạ tầng không chuyên.
+		// ⬅️ CHỐT LẠI THÀNH 0.9 TRƯỚC MAINNET.
+		UptimeRequirement: .8,
+
+		// Rào cản vào làm validator: 2,000 LOVE9.
+		// Cố tình thấp để cộng đồng tự chạy node được — đây là mục đích tồn tại của A1.
+		MinValidatorStake: 2 * units.KiloAvax,
+
+		// Trần stake mỗi validator: 50,000,000 LOVE9.
+		//
+		// KHÁC LocalParams (3,000,000). Lý do: mỗi node genesis nhận
+		// 160,000,000 / 5 = 32,000,000 LOVE9 tiền stake. Với trần 3M của
+		// LocalParams thì validator genesis vượt trần ~10 lần — genesis không
+		// kiểm tra nên vẫn chạy, nhưng tokenomics thành vô lý: không validator
+		// cộng đồng nào được phép stake ngang node genesis. Trần 50M vừa chứa
+		// được node genesis, vừa chặn tập trung quá mức (50M / 720M supply cap ≈ 7%).
+		MaxValidatorStake: 50 * units.MegaAvax,
+
+		// Rào cản uỷ quyền: 25 LOVE9 — người dùng thường tham gia được.
+		MinDelegatorStake: 25 * units.Avax,
+
+		// Phí uỷ quyền tối thiểu validator được thu: 2%.
+		MinDelegationFee: 20_000, // thang 1,000,000 = 100%
+
+		MinStakeDuration:        24 * time.Hour,
+		MaxStakeDuration:        365 * 24 * time.Hour,
+		HeliconMinStakeDuration: 1 * time.Hour,
+
+		RewardConfig: reward.Config{
+			// Lạm phát 10% → 12% theo độ dài thời gian stake (khuyến khích stake dài).
+			MaxConsumptionRate: .12 * reward.PercentDenominator,
+			MinConsumptionRate: .10 * reward.PercentDenominator,
+			MintingPeriod:      365 * 24 * time.Hour,
+
+			// Trần cung TUYỆT ĐỐI: 720,000,000 LOVE9. Không bao giờ mint vượt.
+			// Genesis phát hành 400,000,000 → còn 320,000,000 dành cho phần
+			// thưởng staking trong nhiều năm.
+			// ⬅️ ĐÂY LÀ SỐ CẦN DAVID CHỐT DỨT KHOÁT TRƯỚC MAINNET.
+			SupplyCap: 720 * units.MegaAvax,
+		},
+	},
+}
