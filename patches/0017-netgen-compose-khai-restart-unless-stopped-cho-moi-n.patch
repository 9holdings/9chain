 9chain-a1-tools/netgen/main.go | 20 ++++++++++++++++++++
 1 file changed, 20 insertions(+)

diff --git a/9chain-a1-tools/netgen/main.go b/9chain-a1-tools/netgen/main.go
index 905bb20..7ff43e4 100644
--- a/9chain-a1-tools/netgen/main.go
+++ b/9chain-a1-tools/netgen/main.go
@@ -429,6 +429,26 @@ func buildCompose(nodes []nodeInfo, subnetPrefix, ipv6Subnet string) string {
 		b.WriteString("  " + name + ":\n")
 		b.WriteString("    image: 9chain-a1/node:dev\n")
 		b.WriteString("    container_name: " + name + "\n")
+		// VÌ SAO CÓ DÒNG NÀY (D-071, soát vận hành 2026-08-27):
+		//
+		// Thiếu nó thì Docker lấy mặc định `no`, và mặc định đó KHÔNG PHẢI một lựa
+		// chọn ai đó đã cân nhắc — nó là chỗ không ai điền. Đo trên mạng công khai
+		// `27/08`: cả 9 validator mang `restart=no`, trong khi Blockscout mang
+		// `always` và Caddy/faucet/web mang `unless-stopped`.
+		//
+		// 🔴 Nghĩa là máy chủ reboot ⇒ trang web dậy, faucet dậy, EXPLORER dậy, và
+		// chuỗi nằm im. Đó là dạng hỏng tệ nhất: trang chủ 200, faucet trả `ok`,
+		// explorer mở được — chỉ chuỗi là không tồn tại. Không cổng nào báo gì.
+		//
+		// `unless-stopped` chứ không `always`: nó TÔN TRỌNG lệnh dừng tường minh,
+		// nên rolling-restart của M2 (hạ một node để track subnet mới) vẫn hạ được
+		// node xuống mà nó không tự bật lên giữa chừng.
+		//
+		// ⚠️ Mặt trái của chính vế đó: `docker stop` VÀ `docker kill` đều là "người
+		// dùng chủ động dừng" nên KHÔNG kích hoạt chính sách. Thử bằng `docker kill`
+		// sẽ thấy node không dậy và tưởng cấu hình hỏng — đã suýt kết luận sai đúng
+		// thế lúc nghiệm thu D-071. Muốn thử thì để tiến trình TỰ CHẾT.
+		b.WriteString("    restart: unless-stopped\n")
 		if nd.Index == 1 {
 			// CHỈ mở ra 127.0.0.1, KHÔNG phải 0.0.0.0.
 			//
