-	fmt.Fprintf(&b, "Tổng phát hành genesis: **%s LOVE9** · Trần cung: **720,000,000 LOVE9**\n\n", love9(totalGenesisSupply()))
+	fmt.Fprintf(&b, "Tổng phát hành genesis: **%s LOVE9** · Trần cung: **%s LOVE9**\n\n",
+		love9(totalGenesisSupply()), love9(supplyCapLOVE9*unitLOVE9))
 	b.WriteString("File này CÔNG KHAI được — chỉ chứa địa chỉ, không chứa khoá bí mật.\n\n")
+	// 10 cột: header, dòng ngăn và dòng dữ liệu PHẢI cùng số cột. Bản trước header 10
+	// mà dòng dữ liệu 9 (thiếu cột Hạng mục) — markdown vẫn render, chỉ là lệch nhãn.
 	b.WriteString("| Hạng mục | Quỹ | % | Tổng (LOVE9) | X/P thanh khoản | X/P khoá | Mở khoá | C-Chain | Địa chỉ X | Địa chỉ EVM |\n")
-	b.WriteString("|---|--:|--:|--:|--:|---|--:|---|---|\n")
+	b.WriteString("|---|---|--:|--:|--:|--:|---|--:|---|---|\n")
 	for _, bk := range buckets {
 		f := funds[bk.Key]
 		lock := bk.LockLabel
 		if bk.LockedXP == 0 {
 			lock = "—"
 		}
-		fmt.Fprintf(&b, "| %s | %d%% | %s | %s | %s | %s | %s | `%s` | `%s` |\n",
-			bk.Name, bk.Percent, love9(bk.Total()), love9(bk.LiquidXP), love9(bk.LockedXP),
+		fmt.Fprintf(&b, "| %s | %s | %d%% | %s | %s | %s | %s | %s | `%s` | `%s` |\n",
+			bk.Nhom, bk.Name, bk.NhomPct, love9(bk.Total()), love9(bk.LiquidXP), love9(bk.LockedXP),
 			lock, love9(bk.CChain), f.XAddr, f.EthAddr)
 	}
 	fmt.Fprintf(&b, "\n## Ghi chú\n")
