+++ b/9chain-a1-tools/netgen/allocation.go
@@ -21,6 +21,14 @@ const (
 	// mega = 1,000,000 LOVE9.
 	mega = 1_000_000 * unitLOVE9
 
+	// supplyCapLOVE9 = trần cung, chỉ để IN RA báo cáo. Nguồn sự thật là
+	// `genesis/genesis_9chain_a1.go` (`A1Params…SupplyCap`) — netgen không đọc được
+	// hằng đó vì nó nằm trong package `genesis`, nên con số ở đây là bản CHÉP TAY.
+	// 🔴 Đổi SupplyCap thì phải đổi cả đây; `scripts/check-consistency.mjs` giữ bản
+	// chép thứ ba. Ba bản này đã trôi lệch một lần (báo cáo còn in 720 triệu sau khi
+	// trần lên 9 tỷ) — đó là lý do con số được đặt tên thay vì nằm rải trong chuỗi.
+	supplyCapLOVE9 = uint64(9_000_000_000)
+
 	oneYear     = uint64(365 * 24 * 60 * 60)
 	twoYears    = 2 * oneYear
 	fourYears   = 4 * oneYear
@@ -168,18 +176,21 @@ func love9(n uint64) string {
 func allocationReport(funds map[string]*fund, networkID uint32, nodes int) string {
 	var b strings.Builder
